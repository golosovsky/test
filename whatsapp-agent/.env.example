# ============================================================
# OpenClaw WhatsApp Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#   nano .env
# ============================================================

# --- Gateway Security ---
# Generate a random token: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# --- LLM API Key (REQUIRED) ---
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Web Search (REQUIRED for search functionality) ---
# Get a free key at: https://brave.com/search/api/
# Free tier: 2,000 queries/month (plenty for personal use)
BRAVE_API_KEY=BSA-REPLACE_ME

# --- Paths (usually no need to change) ---
OPENCLAW_STATE_DIR=~/.openclaw
OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json

# --- Docker Compose Variables ---
OPENCLAW_CONFIG_DIR=./openclaw-config
OPENCLAW_WORKSPACE_DIR=./workspace
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=lan
